# ==============================================================================
# Frontend Multi-Stage Dockerfile for React Vite App (Practical 11)
# ==============================================================================

# Stage 1: Build the React application with Vite
FROM node:20-alpine AS build

WORKDIR /app

# Copy dependency manifests
COPY package*.json ./

# Install all dependencies including build tools
RUN npm install

# Copy frontend source files
COPY . .

# Set API URL build argument with default fallback
ARG VITE_API_URL=http://localhost:5001
ENV VITE_API_URL=$VITE_API_URL

# Build the production bundle into /app/dist
RUN npm run build

# Stage 2: Lean runtime stage to serve the built bundle
FROM node:20-alpine AS serve

WORKDIR /app

# Copy built artifacts from the build stage
COPY --from=build /app/dist ./dist
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/vite.config.js ./

# Document container port
EXPOSE 5173

# Serve using Vite preview bound to all network interfaces (0.0.0.0)
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5173"]
